parameters:
    level: 9
    paths:
        - src
    excludePaths:
        - src/Kernel.php
    checkMissingIterableValueType: false
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        - '#Call to an undefined method Symfony\\Component\\Security\\Core\\User\\UserInterface::getId\(\)#'
        - '#Call to an undefined method Symfony\\Component\\Security\\Core\\User\\UserInterface::getEmail\(\)#'
        - '#Call to an undefined method Symfony\\Component\\Security\\Core\\User\\UserInterface::setVerified\(\)#'
        - '#Call to an undefined method Symfony\\Component\\Security\\Core\\User\\UserInterface::getPlan\(\)#'
        - '#unknown class Stripe.*#'
        - '#invalid return type Stripe.*#'
        - '#Access to property .* on an unknown class Stripe.*#'
        - '#Caught class Stripe.* not found.#'
