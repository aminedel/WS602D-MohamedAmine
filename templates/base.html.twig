<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Amine PDF{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>📄</text></svg>">
    
    {% block stylesheets %}
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <link rel="stylesheet" href="{{ asset('css/styles.css') }}">
    {% endblock %}
</head>
<body>
    <div class="app-layout">
        <!-- SIDEBAR -->
        <aside class="sidebar">
            <div class="sidebar-header">
                <a href="{{ path('app_home') }}" class="brand">
                    <div class="brand-icon">
                        <i class="fa-solid fa-file-pdf"></i>
                    </div>
                    <span>Amine PDF</span>
                </a>
            </div>

            <nav class="sidebar-nav">
                {% if app.user %}
                    <div class="nav-section">MENU</div>
                    <a href="{{ path('app_dashboard') }}" class="nav-item {{ app.request.get('_route') == 'app_dashboard' ? 'active' : '' }}">
                        <i class="fa-solid fa-chart-pie"></i>
                        <span>Dashboard</span>
                    </a>
                    <a href="{{ path('app_pdf_generate') }}" class="nav-item {{ app.request.get('_route') == 'app_pdf_generate' ? 'active' : '' }}">
                        <i class="fa-solid fa-wand-magic-sparkles"></i>
                        <span>Générer PDF</span>
                    </a>
                    <a href="{{ path('app_history') }}" class="nav-item {{ app.request.get('_route') == 'app_history' ? 'active' : '' }}">
                        <i class="fa-solid fa-clock-rotate-left"></i>
                        <span>Historique</span>
                    </a>
                    
                    <div class="nav-section">COMPTE</div>
                    <a href="{{ path('app_subscription') }}" class="nav-item {{ app.request.get('_route') == 'app_subscription' ? 'active' : '' }}">
                        <i class="fa-solid fa-crown"></i>
                        <span>Abonnement</span>
                    </a>
                     <a href="{{ path('app_logout') }}" class="nav-item logout">
                        <i class="fa-solid fa-right-from-bracket"></i>
                        <span>Déconnexion</span>
                    </a>
                {% else %}
                    <a href="{{ path('app_login') }}" class="nav-item {{ app.request.get('_route') == 'app_login' ? 'active' : '' }}">
                        <i class="fa-solid fa-right-to-bracket"></i>
                        <span>Connexion</span>
                    </a>
                    <a href="{{ path('app_register') }}" class="nav-item {{ app.request.get('_route') == 'app_register' ? 'active' : '' }}">
                        <i class="fa-solid fa-user-plus"></i>
                        <span>Inscription</span>
                    </a>
                {% endif %}
            </nav>

            <div class="sidebar-footer">
                <p>&copy; 2026 WR602D</p>
            </div>
        </aside>

        <!-- MAIN CONTENT -->
        <main class="main-content">
            <!-- TOP BAR -->
            <header class="top-bar">
                <div class="page-title">
                    <h1>{% block page_title %}Dashboard{% endblock %}</h1>
                </div>
                <div class="user-menu">
                    {% if app.user %}
                        <div class="user-info">
                            <span class="user-name">{{ app.user.firstname }} {{ app.user.lastname }}</span>
                            <span class="user-role">{{ app.user.plan ? app.user.plan.name : 'NO PLAN' }}</span>
                        </div>
                        <div class="user-avatar">
                            {{ app.user.firstname|first }}{{ app.user.lastname|first }}
                        </div>
                    {% else %}
                        <a href="{{ path('app_login') }}" class="btn btn-sm btn-primary">Connexion</a>
                    {% endif %}
                </div>
            </header>

            <div class="content-wrapper">
                {% for message in app.flashes('success') %}
                    <div class="alert alert-success">
                        <i class="fa-solid fa-check-circle"></i> {{ message }}
                    </div>
                {% endfor %}

                {% for message in app.flashes('error') %}
                    <div class="alert alert-error">
                        <i class="fa-solid fa-circle-exclamation"></i> {{ message }}
                    </div>
                {% endfor %}

                {% block body %}{% endblock %}
            </div>
        </main>
    </div>

    {% block javascripts %}{% endblock %}
</body>
</html>
