{% extends 'base.html.twig' %}

{% block title %}Paiement reussi - Amine PDF{% endblock %}
{% block page_title %}Paiement reussi{% endblock %}

{% block body %}
<div style="text-align: center; padding: 4rem 2rem; background: white; border-radius: 16px;">
    <div style="font-size: 4rem; margin-bottom: 1rem;">
        <i class="fa-solid fa-check-circle" style="color: var(--success);"></i>
    </div>
    <h1 style="color: var(--success); margin-bottom: 1rem;">Merci pour votre abonnement !</h1>
    <p style="color: var(--gray); font-size: 1.125rem; margin-bottom: 2rem;">
        Votre paiement a bien ete traite. Votre nouveau plan sera actif dans quelques instants.
    </p>
    <div style="display: flex; gap: 1rem; justify-content: center;">
        <a href="{{ path('app_dashboard') }}" class="btn btn-primary">
            <i class="fa-solid fa-chart-pie"></i> Aller au Dashboard
        </a>
        <a href="{{ path('app_convert_tool', {slug: 'url'}) }}" class="btn btn-secondary">
            <i class="fa-solid fa-wand-magic-sparkles"></i> Generer un PDF
        </a>
    </div>
</div>
{% endblock %}
