{% extends 'base.html.twig' %}

{% block title %}Paiement annule - Amine PDF{% endblock %}
{% block page_title %}Paiement annule{% endblock %}

{% block body %}
<div style="text-align: center; padding: 4rem 2rem; background: white; border-radius: 16px;">
    <div style="font-size: 4rem; margin-bottom: 1rem;">
        <i class="fa-solid fa-times-circle" style="color: var(--danger);"></i>
    </div>
    <h1 style="color: var(--danger); margin-bottom: 1rem;">Paiement annule</h1>
    <p style="color: var(--gray); font-size: 1.125rem; margin-bottom: 2rem;">
        Vous n'avez pas ete debite. Votre abonnement n'a pas ete modifie.
    </p>
    <div style="display: flex; gap: 1rem; justify-content: center;">
        <a href="{{ path('app_subscription') }}" class="btn btn-primary">
            <i class="fa-solid fa-crown"></i> Voir les plans
        </a>
        <a href="{{ path('app_dashboard') }}" class="btn btn-secondary">
            <i class="fa-solid fa-chart-pie"></i> Retour au Dashboard
        </a>
    </div>
</div>
{% endblock %}
