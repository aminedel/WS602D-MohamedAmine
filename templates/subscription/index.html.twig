{% extends 'base.html.twig' %}

{% block title %}Abonnement - PDF Generator{% endblock %}

{% block body %}
<style>
    .subscription-header {
        text-align: center;
        margin-bottom: 3rem;
    }

    .subscription-header h1 {
        font-size: 2.5rem;
        color: white;
        margin-bottom: 1rem;
    }

    .current-plan-badge {
        display: inline-block;
        background: var(--success);
        color: white;
        padding: 0.5rem 1.5rem;
        border-radius: 20px;
        font-weight: 600;
        margin-bottom: 2rem;
    }

    .plans-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 2rem;
    }

    .plan-card {
        background: white;
        padding: 2.5rem;
        border-radius: 16px;
        position: relative;
        transition: transform 0.3s;
    }

    .plan-card:hover {
        transform: translateY(-8px);
    }

    .plan-card.current {
        border: 3px solid var(--success);
        box-shadow: 0 8px 32px rgba(16, 185, 129, 0.3);
    }

    .plan-card.featured {
        border: 3px solid var(--primary);
        box-shadow: 0 8px 32px rgba(99, 102, 241, 0.3);
    }

    .current-badge {
        position: absolute;
        top: -12px;
        right: 20px;
        background: var(--success);
        color: white;
        padding: 0.25rem 1rem;
        border-radius: 20px;
        font-size: 0.875rem;
        font-weight: 600;
    }

    .popular-badge {
        position: absolute;
        top: -12px;
        right: 20px;
        background: var(--primary);
        color: white;
        padding: 0.25rem 1rem;
        border-radius: 20px;
        font-size: 0.875rem;
        font-weight: 600;
    }

    .plan-name {
        font-size: 1.75rem;
        font-weight: 700;
        color: var(--primary);
        margin-bottom: 1rem;
        text-align: center;
    }

    .plan-price {
        font-size: 3rem;
        font-weight: 800;
        color: var(--dark);
        text-align: center;
        margin-bottom: 0.5rem;
    }

    .plan-price span {
        font-size: 1.25rem;
        color: var(--gray);
    }

    .plan-description {
        color: var(--gray);
        margin-bottom: 2rem;
        text-align: center;
        min-height: 80px;
    }

    .plan-features {
        list-style: none;
        margin-bottom: 2rem;
    }

    .plan-features li {
        padding: 0.75rem 0;
        color: var(--dark);
        border-bottom: 1px solid var(--border);
    }

    .plan-features li:last-child {
        border-bottom: none;
    }

    .plan-features li::before {
        content: "✓ ";
        color: var(--success);
        font-weight: bold;
        margin-right: 0.5rem;
        font-size: 1.25rem;
    }

    .plan-action {
        width: 100%;
        padding: 1rem;
        font-size: 1.125rem;
    }
</style>

<div class="subscription-header">
    <h1>💎 Gérer votre Abonnement</h1>
    {% if currentPlan %}
        <div class="current-plan-badge">
            Abonnement actuel : {{ currentPlan.name }}
        </div>
    {% endif %}
</div>

<div class="plans-grid">
    {% for plan in plans %}
        <div class="plan-card {% if currentPlan and currentPlan.id == plan.id %}current{% elseif plan.name == 'BASIC' %}featured{% endif %}">
            {% if currentPlan and currentPlan.id == plan.id %}
                <div class="current-badge">✓ ACTUEL</div>
            {% elseif plan.name == 'BASIC' %}
                <div class="popular-badge">⭐ POPULAIRE</div>
            {% endif %}
            
            <div class="plan-name">{{ plan.name }}</div>
            
            <div class="plan-price">
                {% if plan.currentPrice == '0.00' %}
                    Gratuit
                {% else %}
                    {{ plan.currentPrice }}€
                    <span>/mois</span>
                {% endif %}
            </div>

            {% if plan.specialPrice and plan.currentPrice == plan.specialPrice %}
                <div style="text-align: center; color: var(--danger); font-weight: 600; margin-bottom: 1rem;">
                    <s>{{ plan.price }}€</s> Prix spécial !
                </div>
            {% endif %}
            
            <div class="plan-description">
                {{ plan.description }}
            </div>
            
            <ul class="plan-features">
                <li>
                    {% if plan.limitGeneration is null %}
                        <strong>Génération illimitée</strong>
                    {% else %}
                        <strong>{{ plan.limitGeneration }} PDFs par jour</strong>
                    {% endif %}
                </li>
                <li>Conversion URL vers PDF</li>
                <li>Conversion Fichier vers PDF</li>
                <li>Éditeur HTML (WYSIWYG)</li>
                <li>Historique complet</li>
                <li>Téléchargement illimité</li>
                {% if plan.name == 'PREMIUM' %}
                    <li><strong>Support prioritaire</strong></li>
                    <li><strong>API Access</strong></li>
                    <li><strong>Pas de publicité</strong></li>
                {% endif %}
            </ul>
            
            {% if currentPlan and currentPlan.id == plan.id %}
                <button class="btn btn-secondary plan-action" disabled>
                    ✓ Abonnement actuel
                </button>
            {% else %}
                <form method="post" action="{{ path('app_subscription_change', {planId: plan.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('subscription_change') }}">
                    <button type="submit" class="btn btn-primary plan-action">
                        {% if currentPlan %}
                            Changer pour {{ plan.name }}
                        {% else %}
                            Choisir {{ plan.name }}
                        {% endif %}
                    </button>
                </form>
            {% endif %}
        </div>
    {% endfor %}
</div>

<div class="card" style="margin-top: 3rem; text-align: center;">
    <h2 style="color: var(--primary); margin-bottom: 1rem;">❓ Questions fréquentes</h2>
    <p style="color: var(--gray); margin-bottom: 1rem;">
        Vous pouvez changer d'abonnement à tout moment. Les changements sont effectifs immédiatement.
    </p>
    <p style="color: var(--gray);">
        Pour toute question, contactez notre support : <strong>support@pdfgenerator.com</strong>
    </p>
</div>
{% endblock %}
