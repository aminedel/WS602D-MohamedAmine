{% extends 'base.html.twig' %}

{% block title %}Abonnement - Amine PDF{% endblock %}
{% block page_title %}Abonnement{% endblock %}

{% block body %}
<style>
    .sub-header {
        text-align: center;
        margin-bottom: 2.5rem;
    }
    .sub-header h1 {
        font-size: 1.75rem;
        color: var(--text-primary);
        margin-bottom: 0.75rem;
        font-weight: 800;
    }
    .current-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: var(--success-light);
        color: #065f46;
        padding: 0.5rem 1.25rem;
        border-radius: 20px;
        font-weight: 700;
        font-size: 0.85rem;
        border: 1px solid #a7f3d0;
    }
    .plans-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 1.5rem;
    }
    .plan-card {
        background: #fff;
        padding: 2rem;
        border-radius: 16px;
        position: relative;
        transition: all 0.2s;
        border: 2px solid var(--border);
    }
    .plan-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--shadow-lg);
    }
    .plan-card.is-current {
        border-color: var(--success);
        box-shadow: 0 4px 20px rgba(5,150,105,0.12);
    }
    .plan-card.is-popular {
        border-color: var(--primary);
        box-shadow: 0 4px 20px rgba(37,99,235,0.12);
    }
    .badge-top {
        position: absolute;
        top: -12px;
        left: 50%;
        transform: translateX(-50%);
        padding: 0.3rem 1rem;
        border-radius: 20px;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        white-space: nowrap;
    }
    .badge-current {
        background: var(--success);
        color: #fff;
    }
    .badge-popular {
        background: var(--primary);
        color: #fff;
    }
    .plan-name {
        font-size: 1.35rem;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 0.5rem;
        text-align: center;
    }
    .plan-price {
        font-size: 2.5rem;
        font-weight: 800;
        color: var(--text-primary);
        text-align: center;
        margin-bottom: 0.25rem;
        letter-spacing: -0.03em;
    }
    .plan-price span {
        font-size: 1rem;
        color: var(--text-secondary);
        font-weight: 500;
    }
    .plan-desc {
        color: var(--text-secondary);
        margin-bottom: 1.5rem;
        text-align: center;
        font-size: 0.9rem;
        min-height: 44px;
    }
    .plan-list {
        list-style: none;
        margin-bottom: 1.5rem;
    }
    .plan-list li {
        padding: 0.5rem 0;
        color: var(--text-primary);
        font-size: 0.9rem;
        border-bottom: 1px solid #f1f5f9;
    }
    .plan-list li:last-child { border-bottom: none; }
    .plan-list li::before {
        content: "\f00c";
        font-family: "Font Awesome 6 Free";
        font-weight: 900;
        color: var(--success);
        margin-right: 0.6rem;
        font-size: 0.8rem;
    }
    .plan-action {
        width: 100%;
        padding: 0.85rem;
        font-size: 0.95rem;
    }
</style>

<div class="sub-header">
    <h1><i class="fa-solid fa-crown"></i> Gerer votre Abonnement</h1>
    {% if currentPlan %}
        <div class="current-badge">
            <i class="fa-solid fa-check-circle"></i>
            Plan actuel : {{ currentPlan.name }}
        </div>
    {% endif %}
</div>

<div class="plans-grid">
    {% for plan in plans %}
        <div class="plan-card {% if currentPlan and currentPlan.id == plan.id %}is-current{% elseif plan.name == 'BASIC' %}is-popular{% endif %}">
            {% if currentPlan and currentPlan.id == plan.id %}
                <div class="badge-top badge-current"><i class="fa-solid fa-check"></i> Actuel</div>
            {% elseif plan.name == 'BASIC' %}
                <div class="badge-top badge-popular"><i class="fa-solid fa-star"></i> Populaire</div>
            {% endif %}

            <div class="plan-name">{{ plan.name }}</div>

            <div class="plan-price">
                {% if plan.currentPrice == '0.00' or plan.currentPrice == '0' %}
                    0<span>&euro;</span>
                {% else %}
                    {{ plan.currentPrice }}<span>&euro;/mois</span>
                {% endif %}
            </div>

            <div class="plan-desc">{{ plan.description }}</div>

            <ul class="plan-list">
                <li>
                    {% if plan.limitGeneration is null %}
                        <strong>Generation illimitee</strong>
                    {% else %}
                        <strong>{{ plan.limitGeneration }} PDFs / jour</strong>
                    {% endif %}
                </li>
                {% for tool in plan.tools %}
                    <li>{{ tool.name }}</li>
                {% endfor %}
                {% if plan.name == 'PREMIUM' %}
                    <li><strong>Support prioritaire</strong></li>
                {% endif %}
            </ul>

            {% if currentPlan and currentPlan.id == plan.id %}
                <button class="btn btn-secondary plan-action" disabled>
                    <i class="fa-solid fa-check"></i> Plan actuel
                </button>
            {% else %}
                <form method="post" action="{{ path('app_subscription_change', {planId: plan.id}) }}" style="margin:0;">
                    <button type="submit" class="btn btn-primary plan-action" data-cy="subscribe-{{ plan.name|lower }}">
                        <i class="fa-solid fa-arrow-right"></i> Choisir {{ plan.name }}
                    </button>
                </form>
            {% endif %}
        </div>
    {% endfor %}
</div>
{% endblock %}
