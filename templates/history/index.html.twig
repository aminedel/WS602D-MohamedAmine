{% extends 'base.html.twig' %}

{% block title %}Historique - PDF Generator{% endblock %}

{% block body %}
<div class="card" style="text-align: center; border: none; background: transparent; box-shadow: none; padding: 0;">
    <h1 style="color: var(--text-primary); margin-bottom: 2rem; font-size: 2rem;">📚 Historique des Générations</h1>
</div>

<div class="history-stats">
    <div class="stat-card">
        <div class="stat-value">{{ generations|length }}</div>
        <div class="stat-label">Total de PDFs</div>
    </div>
    <div class="stat-card">
        <div class="stat-value">
            {{ generations|filter(g => g.createdAt|date('Y-m-d') == 'now'|date('Y-m-d'))|length }}
        </div>
        <div class="stat-label">Aujourd'hui</div>
    </div>
    <div class="stat-card">
        <div class="stat-value">
            {{ generations|filter(g => g.createdAt > date('-7 days'))|length }}
        </div>
        <div class="stat-label">Cette semaine</div>
    </div>
</div>

{% if generations|length > 0 %}
    <div class="history-table">
        <table class="table">
            <thead>
                <tr>
                    <th>📅 Date</th>
                    <th>🏷️ Type</th>
                    <th>📄 Fichier</th>
                    <th>🔗 Source</th>
                    <th>⚡ Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for generation in generations %}
                    <tr>
                        <td>{{ generation.createdAt|date('d/m/Y H:i') }}</td>
                        <td>
                            <span class="type-badge type-{{ generation.type }}">
                                {% if generation.type == 'url' %}🌐 URL
                                {% elseif generation.type == 'file' %}📁 Fichier
                                {% else %}✏️ HTML{% endif %}
                            </span>
                        </td>
                        <td>
                            <code style="font-size: 0.875rem;">{{ generation.file }}</code>
                        </td>
                        <td>
                            {% if generation.sourceUrl %}
                                <a href="{{ generation.sourceUrl }}" target="_blank" style="color: var(--primary); text-decoration: none;">
                                    {{ generation.sourceUrl|slice(0, 40) }}...
                                </a>
                            {% else %}
                                <span style="color: var(--gray);">-</span>
                            {% endif %}
                        </td>
                        <td>
                            <a href="{{ path('app_pdf_download', {id: generation.id}) }}" 
                               class="btn btn-primary btn-download"
                               target="_blank">
                                📥 Télécharger
                            </a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% else %}
    <div class="card">
        <div class="empty-state">
            <div class="empty-state-icon">📭</div>
            <h2 style="color: var(--dark); margin-bottom: 1rem;">Aucune génération pour le moment</h2>
            <p style="margin-bottom: 2rem;">Commencez à générer des PDFs pour les voir apparaître ici !</p>
            <a href="{{ path('app_pdf_generate') }}" class="btn btn-primary">
                🚀 Générer mon premier PDF
            </a>
        </div>
    </div>
{% endif %}
{% endblock %}
