{% extends 'base.html.twig' %}

{% block title %}Acces refuse - Amine PDF{% endblock %}
{% block page_title %}Acces refuse{% endblock %}

{% block body %}
<div style="text-align: center; padding: 4rem 2rem; background: #fff; border-radius: 16px; border: 1px solid var(--border);">
    <div style="font-size: 4rem; margin-bottom: 1rem;">
        <i class="fa-solid fa-shield-halved" style="color: var(--danger);"></i>
    </div>
    <h1 style="color: var(--danger); margin-bottom: 0.75rem; font-size: 2rem;">Acces refuse (403)</h1>
    <p style="color: var(--text-secondary); font-size: 1.1rem; margin-bottom: 1rem;">
        Votre plan actuel ne vous donne pas acces a cette fonctionnalite.
    </p>

    {% if app.user and app.user.plan %}
        <div style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--primary-light, #dbeafe); color: var(--primary); padding: 0.5rem 1.25rem; border-radius: 20px; font-weight: 700; font-size: 0.9rem; margin-bottom: 2rem;">
            <i class="fa-solid fa-tag"></i>
            Plan actuel : {{ app.user.plan.name }}
        </div>
    {% endif %}

    <div style="display: flex; gap: 1rem; justify-content: center; margin-top: 1.5rem;">
        <a href="{{ path('app_subscription') }}" class="btn btn-primary">
            <i class="fa-solid fa-crown"></i> Voir les offres
        </a>
        <a href="{{ path('app_dashboard') }}" class="btn btn-secondary">
            <i class="fa-solid fa-arrow-left"></i> Retour au Dashboard
        </a>
    </div>
</div>
{% endblock %}
