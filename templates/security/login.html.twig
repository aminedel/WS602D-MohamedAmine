{% extends 'base.html.twig' %}

{% block title %}Connexion - Amine PDF{% endblock %}
{% block page_title %}Connexion{% endblock %}

{% block body %}
<style>
    .login-container {
        max-width: 480px;
        margin: 2rem auto;
    }
    .login-card {
        background: white;
        padding: 2.5rem;
        border-radius: 16px;
    }
    .login-card h2 {
        text-align: center;
        color: var(--primary);
        margin-bottom: 2rem;
    }
</style>

<div class="login-container">
    <div class="login-card">
        <h2>Connexion</h2>

        {% if error %}
            <div class="alert alert-error">
                <i class="fa-solid fa-circle-exclamation"></i>
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        {% if app.user %}
            <div style="margin-bottom: 1rem; text-align: center;">
                Connecte en tant que {{ app.user.userIdentifier }},
                <a href="{{ path('app_logout') }}">Deconnexion</a>
            </div>
        {% endif %}

        <form method="post">
            <div class="form-group">
                <label for="username" class="form-label">Email</label>
                <input type="email" value="{{ last_username }}" name="_username" id="username"
                       class="form-control" autocomplete="email" required autofocus
                       placeholder="votre@email.com">
            </div>

            <div class="form-group">
                <label for="password" class="form-label">Mot de passe</label>
                <input type="password" name="_password" id="password"
                       class="form-control" autocomplete="current-password" required>
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
                <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
                    <input type="checkbox" name="_remember_me"> Se souvenir de moi
                </label>
                <a href="{{ path('app_forgot_password_request') }}" style="color: var(--primary); font-size: 0.9rem;">
                    Mot de passe oublie ?
                </a>
            </div>

            <button class="btn btn-primary" type="submit" style="width: 100%;">
                <i class="fa-solid fa-right-to-bracket"></i> Se connecter
            </button>
        </form>

        <div style="text-align: center; margin-top: 1.5rem;">
            <span style="color: var(--gray);">Pas encore de compte ?</span>
            <a href="{{ path('app_register') }}" style="color: var(--primary); font-weight: 600;">
                Creer un compte
            </a>
        </div>
    </div>
</div>
{% endblock %}
